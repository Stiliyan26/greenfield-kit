{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "greenfield-kit": { "source": { "source": "github", "repo": "Stiliyan26/greenfield-kit" } }
  },
  "enabledPlugins": {
    "greenfield-kit@greenfield-kit": true
  },
  "permissions": {
    "deny": ["Read(./.env)", "Read(./.env.*)", "Edit(./.env)", "Edit(./.env.*)", "Bash(rm -rf:*)", "Bash(git push --force:*)"]
  }
}
